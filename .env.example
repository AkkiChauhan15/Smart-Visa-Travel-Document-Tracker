# Application
NODE_ENV=
PORT=
FRONTEND_URL=
VITE_API_URL=
VITE_MAX_UPLOAD_BYTES=
SERVE_FRONTEND=
FRONTEND_DIST_DIR=

# PostgreSQL (DATABASE_URL is consumed by the backend; the POSTGRES_* values are consumed by Docker Compose)
DATABASE_URL=
DATABASE_SSL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=
BCRYPT_ROUNDS=
COOKIE_SECURE=

# Private file uploads (optional; defaults shown in README)
UPLOAD_DIR=
MAX_UPLOAD_BYTES=

# Email provider (reserved for the notification task)
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=

# Reminder scheduler and SMTP delivery
REMINDER_JOB_ENABLED=
REMINDER_JOB_INTERVAL_MS=
REMINDER_RUN_ON_STARTUP=
SMTP_CONNECTION_TIMEOUT_MS=

# Browser verification script
UI_BASE_URL=
API_BASE_URL=
CHROME_BIN=
